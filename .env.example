# Copy to .env.local for local development. Never commit real values.

# Provisioning API (server-side only; never prefix these with NEXT_PUBLIC_)
WAAS_API_URL=https://api.example.com
WAAS_ADMIN_TOKEN=

# Set to 1 to use the built-in sample data instead of the API (local UI work only).
WAAS_API_FIXTURES=

# Auth.js: sign-in with GitHub, limited to the logins below
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ALLOWED_GITHUB_LOGINS=
# Off Vercel, set to true so Auth.js accepts your host.
AUTH_TRUST_HOST=

# Only for adding Shadcn UI Kit components with the shadcn CLI (components.json reads it).
SHADCNUIKIT_API_KEY=
