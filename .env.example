# Copy to .env.local for local development. Never commit real values.

# Provisioning API (server-side only; never prefix these with NEXT_PUBLIC_)
WAAS_API_URL=https://api.example.com
WAAS_ADMIN_TOKEN=

# Set to 1 to use the built-in sample data instead of the API (local UI work only).
WAAS_API_FIXTURES=

# Sign-in runs on the API (its AUTH_URL is this dashboard's address). The platform admins, who
# see every storefront, by email address or GitHub login; everyone else sees only their own storefront.
ALLOWED_ADMIN_EMAILS=
ALLOWED_GITHUB_LOGINS=
# Ways to sign in: email (default, an emailed link), plus github or google once the API has them.
AUTH_PROVIDERS=

# Only for adding Shadcn UI Kit components with the shadcn CLI (components.json reads it).
SHADCNUIKIT_API_KEY=
